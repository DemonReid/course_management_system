{
  "id": "process-assessment-score",
  "name": "过程性考核成绩构成登记表",
  "description": "课程考核成绩比例构成及过程性考核具体方式",
  "priority": "P1",
  "category": "过程性考核",
  "checkPhase": [
    "期前"
  ],
  "aiAutomationLevel": "medium",
  "estimatedTokens": 500,
  "fields": [
    {
      "key": "courseName",
      "label": "课程名称",
      "type": "text",
      "required": true,
      "placeholder": "如：预防医学"
    },
    {
      "key": "className",
      "label": "班级",
      "type": "text",
      "required": true,
      "placeholder": "如：食品营养与健康2024班"
    },
    {
      "key": "teacherName",
      "label": "任课教师",
      "type": "text",
      "required": true,
      "autoFill": "currentUser"
    },
    {
      "key": "semester",
      "label": "学期",
      "type": "text",
      "required": true,
      "autoFill": "currentSemester"
    },
    {
      "key": "department",
      "label": "所在教研室",
      "type": "text",
      "required": true,
      "defaultValue": "预防医学教研室"
    },
    {
      "key": "totalHours",
      "label": "总学时",
      "type": "text",
      "required": true
    },
    {
      "key": "theoryHours",
      "label": "理论学时",
      "type": "text",
      "required": true
    },
    {
      "key": "practiceHours",
      "label": "实践学时",
      "type": "text",
      "required": true
    },
    {
      "key": "processRatio",
      "label": "过程性考核比例（%）",
      "type": "number",
      "required": true,
      "defaultValue": 40
    },
    {
      "key": "finalRatio",
      "label": "结果性考核比例（%）",
      "type": "number",
      "required": true,
      "defaultValue": 60
    },
    {
      "key": "midtermWeight",
      "label": "中期考核权重（%）",
      "type": "number",
      "required": true,
      "defaultValue": 50
    },
    {
      "key": "attendanceWeight",
      "label": "考勤权重（%）",
      "type": "number",
      "required": false,
      "defaultValue": 10
    },
    {
      "key": "teacherEvalWeight",
      "label": "教师评价权重（%）",
      "type": "number",
      "required": false,
      "defaultValue": 10
    },
    {
      "key": "homeworkWeight",
      "label": "作业权重（%）",
      "type": "number",
      "required": false,
      "defaultValue": 10
    },
    {
      "key": "onlineWeight",
      "label": "线上互动权重（%）",
      "type": "number",
      "required": false,
      "defaultValue": 10
    },
    {
      "key": "classQuestionWeight",
      "label": "课堂提问权重（%）",
      "type": "number",
      "required": false,
      "defaultValue": 10
    },
    {
      "key": "otherMethod",
      "label": "其他考核方式",
      "type": "text",
      "required": false,
      "placeholder": "如有其他考核方式请填写"
    },
    {
      "key": "otherWeight",
      "label": "其他方式权重（%）",
      "type": "number",
      "required": false
    }
  ],
  "sections": [
    {
      "title": "基本信息",
      "fields": [
        "courseName",
        "className",
        "teacherName",
        "semester",
        "department",
        "totalHours",
        "theoryHours",
        "practiceHours"
      ]
    },
    {
      "title": "成绩比例",
      "fields": [
        "processRatio",
        "finalRatio"
      ]
    },
    {
      "title": "过程性考核构成",
      "fields": [
        "midtermWeight",
        "attendanceWeight",
        "teacherEvalWeight",
        "homeworkWeight",
        "onlineWeight",
        "classQuestionWeight",
        "otherMethod",
        "otherWeight"
      ]
    }
  ],
  "aiSystemPrompt": null,
  "sampleData": {
    "courseName": "预防医学",
    "className": "养老服务管理2023班",
    "teacherName": "彭芳",
    "semester": "2025-2026学年第1学期",
    "department": "预防医学教研室",
    "totalHours": "36学时",
    "theoryHours": "36学时",
    "practiceHours": "0",
    "processRatio": 40,
    "finalRatio": 60,
    "midtermWeight": 50,
    "attendanceWeight": 10,
    "teacherEvalWeight": 10,
    "homeworkWeight": 10,
    "onlineWeight": 10,
    "classQuestionWeight": 10
  }
}