      "type": "number",
      "required": true
    },
    {
      "key": "avgScore",
      "label": "平均分",
      "type": "number",
      "required": true
    },
    {
      "key": "highestScore",
      "label": "最高分",
      "type": "number",
      "required": true
    },
    {
      "key": "lowestScore",
      "label": "最低分",
      "type": "number",
      "required": true
    },
    {
      "key": "passRate",
      "label": "及格率（%）",
      "type": "number",
      "required": true
    },
    {
      "key": "scoreDistribution",
      "label": "成绩分布说明",
      "type": "longtext",
      "required": true,
      "aiGenerated": true,
      "rows": 4
    },
    {
      "key": "paperQualityAnalysis",
      "label": "试卷质量分析",
      "type": "longtext",
      "required": true,
      "aiGenerated": true,
      "rows": 4
    },
    {
      "key": "problems",
      "label": "存在问题",
      "type": "longtext",
      "required": true,
      "aiGenerated": true,
